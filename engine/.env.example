# Copy to .env and fill in. Never commit .env.
ENGINE_API_KEY=change-me-long-random-string
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# LLM for the farmer-facing text. Set ONE key. No key = template text (still works, en + ar).
# LLM_PROVIDER = groq | openrouter | gemini | anthropic   (empty = first key that is set, in that order)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = openai/gpt-oss-120b (Groq), google/gemma-4-31b-it:free (OpenRouter), gemini-3.8-flash (Gemini), claude-sonnet-5-5 (Claude)
LLM_MODEL=openai/gpt-oss-120b

# Copernicus Data Space OAuth client, for Sentinel-2 NDVI. Empty = NDVI layer skipped.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# true = show labelled demo values for NDVI / SMAP / IMERG while those layers are not set up.
USE_MOCK_LAYERS=false
