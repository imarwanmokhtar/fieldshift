# Copy to .env and fill in. Never commit .env.
ENGINE_API_KEY=change-me-long-random-string
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# LLM for the farmer-facing text. Set ONE key. No key = template text (still works, en + ar).
# LLM_PROVIDER = gemini | anthropic   (empty = whichever key is set; Gemini wins if both)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = gemini-2.5-flash for Gemini, claude-sonnet-5-5 for Claude
LLM_MODEL=gemini-2.5-flash

# Copernicus Data Space OAuth client, for Sentinel-2 NDVI. Empty = NDVI layer skipped.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# true = show labelled demo values for NDVI / SMAP / IMERG while those layers are not set up.
USE_MOCK_LAYERS=false
